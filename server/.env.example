# AfroMessage SMS (never commit real values — copy to .env)
AFROMESSAGE_TOKEN=
# Optional short-code identifier from AfroMessage Identifiers list (not JWT id)
AFROMESSAGE_IDENTIFIER=
AFROMESSAGE_SENDER=

# Set to 1 only for local UI tests without SMS. Keep 0 in production.
AUTH_OTP_DEV_BYPASS=0
AUTH_OTP_DEV_CODE=1234

# Postgres (required in production; do not use weak defaults in prod)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/chkela
PORT=3001
# Use 127.0.0.1 locally; set 0.0.0.0 only when devices on LAN must reach the API
HOST=127.0.0.1

# Auth secrets (generate with: openssl rand -hex 32)
SESSION_JWT_SECRET=
ADMIN_JWT_SECRET=
# Dashboard / admin API password
ADMIN_PASSWORD=

# Comma-separated allowed browser origins for CORS (dashboard + local vite)
# Required in production. Dev fallback is localhost only unless ALLOW_LAN_CORS=1.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set to 1 only for Flutter device testing against a LAN dashboard origin
ALLOW_LAN_CORS=0

# Behind nginx/Cloudflare set TRUST_PROXY=1 so rate limits use the real client IP
TRUST_PROXY=0

# Global API rate limit (requests per minute per IP)
RATE_LIMIT_MAX=120

# Path progress shared secret (Flutter --dart-define=CHKELA_PATH_PROGRESS_SECRET=...)
CHKELA_PATH_PROGRESS_SECRET=

NODE_ENV=development

# Google Gemini (keep real key only in .env; rotate if ever pasted in chat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_FREE_TUTOR_LIMIT=3
AI_FREE_WRONG_LIMIT=20
AI_FREE_EXPLAIN_LIMIT=20
